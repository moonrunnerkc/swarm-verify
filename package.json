{
  "name": "swarm-verify",
  "version": "2.1.0-rc.2",
  "description": "Measure a candidate change against a project's own checks and declared requirements in a clean checkout, test by test against the base, and sign the result as an in-toto Statement in a DSSE envelope that verify.mjs or cosign can check offline.",
  "keywords": [
    "verification",
    "in-toto",
    "dsse",
    "sigstore",
    "cosign",
    "attestation",
    "held-out-tests",
    "mutation-testing",
    "coverage",
    "ci",
    "github-action",
    "pre-commit",
    "ai-coding-agents"
  ],
  "homepage": "https://github.com/moonrunnerkc/swarm-verify#readme",
  "bugs": {
    "url": "https://github.com/moonrunnerkc/swarm-verify/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonrunnerkc/swarm-verify.git"
  },
  "license": "ISC",
  "type": "module",
  "bin": {
    "swarm-verify": "dist/swarm-verify.js",
    "swarm-verify-mcp": "mcp.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./execution": {
      "types": "./dist/execution.d.ts",
      "default": "./dist/execution.js"
    },
    "./package.json": "./package.json",
    "./cli": {
      "types": "./dist/cli-commands.d.ts",
      "default": "./dist/cli-commands.js"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "checks": "node scripts/check-doc-paths.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run",
    "gates": "npm run checks && npm run caps && npm run typecheck && npm run lint && npm test && npm run build",
    "prepack": "npm run build",
    "caps": "node scripts/check-caps.mjs"
  },
  "dependencies": {
    "smol-toml": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist/",
    "verify.mjs",
    "mcp.mjs",
    "action.yml",
    "README.md",
    "CHANGELOG.md"
  ]
}
